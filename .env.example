# ── QuizFlow configuration (copy to .env and adjust) ──────────────────────────

# HTTP
PORT=4000
# CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── MySQL (primary database) ──────────────────────────────────────────────────
# Full URL form (wins over the discrete variables):
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/quiz_platform
# Or discrete variables:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=quiz_platform
# Set to 1 to force the embedded fallback engine (no MySQL attempts)
# MYSQL_DISABLED=1

# If no MySQL server is reachable, the API automatically falls back to an
# embedded database (Node's built-in SQLite) stored at:
# SQLITE_FILE=server/data/quiz_platform.sqlite

# ── AI provider (quiz generation) ─────────────────────────────────────────────
# auto (default): uses GEMINI_API_KEY or OPENAI_API_KEY when present,
# otherwise the built-in offline demo generator.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
