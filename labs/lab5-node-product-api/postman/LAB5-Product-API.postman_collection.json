{
  "info": {
    "_postman_id": "ccaa41cc-ae85-4ed7-a0ec-a8a5a69ee5d5",
    "name": "LAB5 - API Produits Node.js Express",
    "description": "Collection CRUD pour l'API Express du LAB5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Vérifier le serveur",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Serveur disponible\", function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "2. Lister les produits",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Liste disponible\", function () { pm.response.to.have.status(200); });",
        "pm.test(\"La réponse contient le tableau data\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
      ]}}]
    },
    {
      "name": "3. Créer un produit",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tapis\",\n  \"price\": 10,\n  \"stock\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Création réussie\", function () { pm.response.to.have.status(201); });",
        "const product = pm.response.json().data;",
        "pm.collectionVariables.set(\"productId\", product.id);",
        "console.log(\"productId =\", product.id);"
      ]}}]
    },
    {
      "name": "4. Lire un produit",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Lecture réussie\", function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "5. Remplacer un produit (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Clavier Gamer\",\n  \"price\": 80,\n  \"stock\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Modification complète réussie\", function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "6. Modifier partiellement (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 20\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Modification partielle réussie\", function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "7. ID invalide (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/1abc", "host": ["{{baseUrl}}"], "path": ["api", "products", "1abc"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"ID invalide rejeté\", function () { pm.response.to.have.status(400); });"
      ]}}]
    },
    {
      "name": "8. Produit inexistant (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/999", "host": ["{{baseUrl}}"], "path": ["api", "products", "999"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Produit absent détecté\", function () { pm.response.to.have.status(404); });"
      ]}}]
    },
    {
      "name": "9. Corps invalide (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"price\": -1,\n  \"stock\": 0\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Corps invalide rejeté\", function () { pm.response.to.have.status(400); });"
      ]}}]
    },
    {
      "name": "10. Supprimer le produit créé",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Suppression réussie\", function () { pm.response.to.have.status(204); });"
      ]}}]
    }
  ]
}
